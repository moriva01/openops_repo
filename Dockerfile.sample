FROM python:3.12-slim
WORKDIR /app
COPY run.py .
COPY apps/openops/LICENSE LICENSE
COPY input_examples input_examples
COPY apps/openops/receiver/__init__.py apps/openops/receiver/
COPY apps/openops/receiver/sample_runner.py apps/openops/receiver/
COPY apps/openops/receiver/investigation_engine.py apps/openops/receiver/
COPY apps/openops/receiver/monitor_logic.py apps/openops/receiver/
COPY apps/openops/receiver/world_model.py apps/openops/receiver/
RUN useradd --system --uid 10001 sample && mkdir -p /app/.local && chown sample /app/.local
USER sample
ENV SAMPLE_MODE=true PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
ENTRYPOINT ["python", "run.py"]
CMD ["--all", "--quiet-trace"]
